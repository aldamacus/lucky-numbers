# Copy to .env and fill in your key.
# .env is gitignored. NEVER put a real key here.

# ─── VedAstro (planet/transit/dasa data) ──────────────────────────────────
VEDASTRO_API_KEY=your-api-key-here
VEDASTRO_URL=https://mcp.vedastro.org/api/mcp/public

# ─── Access gate for the Streamlit UI ─────────────────────────────────────
# Comma-separated list of access keys. Anyone visiting the deployed app
# gets 4 free generations; after that, they must enter one of these keys
# to keep generating numbers.
#
# Leave empty (or unset) to disable the gate entirely (open-access mode,
# useful in local dev).
#
# Example with three keys for three users / friends:
#   LUCKY_NUMBERS_ACCESS_KEYS=alpha-key-123,bravo-key-456,charlie-key-789
LUCKY_NUMBERS_ACCESS_KEYS=

